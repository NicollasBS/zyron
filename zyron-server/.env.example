# ==============================================================================
# Zyron Server - Variáveis de Ambiente (CI/CD e Ambientes de Execução)
# ==============================================================================

# Configurações da Aplicação
PORT=8080
PROD_APP_PORT=8080
DEV_APP_PORT=8080
LOCAL_APP_PORT=8080

# Configurações do Banco de Dados PostgreSQL (zyron_db)
DB_HOST=zyron_db
DB_PORT=5432
DB_USER=zyron_user
DB_PASSWORD=sua_senha_segura_do_banco
DB_NAME=zyron_db
DB_SSLMODE=disable

# Portas de bind no host (se desejar expor o banco para ferramentas como DBeaver / pgAdmin)
DEV_POSTGRES_PORT=5432
LOCAL_POSTGRES_PORT=5432

# Configurações do Redis (zyron_redis)
REDIS_ADDR=zyron_redis:6379
REDIS_PASSWORD=sua_senha_segura_do_redis
REDIS_DB=0

# Portas de bind no host para o Redis
DEV_REDIS_PORT=6379
LOCAL_REDIS_PORT=6379

# Configurações de Container Registry para CI/CD
CI_REGISTRY_IMAGE=registry.gitlab.com/seu-grupo/zyron-server
CI_COMMIT_REF_SLUG=dev
IMAGE_TAG=latest

# Configurações do Active Directory (AD / LDAPS)
AD_HOST=dc01.empresa.local
AD_PORT=636
AD_USE_SSL=true
AD_INSECURE_SKIP_VERIFY=true
AD_BASE_DN=DC=empresa,DC=local
AD_BIND_USER=svc_zyron@empresa.local
AD_BIND_PASSWORD=senha_conta_de_servico_aqui
AD_OPERATOR_GROUP=Suporte_TI
